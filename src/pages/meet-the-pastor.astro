---
import { Image } from 'astro:assets';
import SiteShell from '../components/SiteShell.astro';
import PageBanner from '../components/PageBanner.astro';
import { getReader } from '../lib/reader';
import { markdocToHtml } from '../lib/markdoc';

const reader = getReader();
const pastor = await reader.singletons.pastor.read();
if (!pastor) {
  throw new Error('Pastor content is missing.');
}

const bioHtml = await markdocToHtml(pastor.bio);
const photo = pastor.photo ? `/images/${pastor.photo}` : null;
---

<SiteShell title={pastor.pageTitle} description={`Meet ${pastor.name} at Wandin Baptist Church.`}>
  <PageBanner title={pastor.pageTitle} />
  <section class="py-14 md:py-16">
    <div class="section-shell grid gap-10 md:grid-cols-[380px_1fr] md:items-start">
      {
        photo && (
          <Image
            src={photo}
            alt={pastor.photoAlt || pastor.name}
            width={655}
            height={400}
            class="mx-auto w-full max-w-md object-cover shadow-md md:max-w-none"
            loading="eager"
          />
        )
      }
      <div>
        <h2 class="font-display text-2xl font-semibold text-eucalyptus-900 md:text-3xl">
          {pastor.name}
        </h2>
        <div class="prose-church mt-6" set:html={bioHtml} />
      </div>
    </div>
  </section>
</SiteShell>
