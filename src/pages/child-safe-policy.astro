---
import SiteShell from '../components/SiteShell.astro';
import PageBanner from '../components/PageBanner.astro';
import { getReader } from '../lib/reader';
import { markdocToHtml } from '../lib/markdoc';

const reader = getReader();
const page = await reader.singletons.childSafePolicy.read();
if (!page) {
  throw new Error('Child Safe Policy content is missing.');
}

const bodyHtml = await markdocToHtml(page.body);
---

<SiteShell title={page.pageTitle} description="Wandin Baptist Church Safe Church and Child Safe Policy.">
  <PageBanner title="Safe Church" />
  <section class="py-14 md:py-16">
    <div class="section-shell max-w-3xl">
      <h2 class="font-display text-2xl font-semibold text-eucalyptus-900 md:text-3xl">
        {page.heading}
      </h2>
      <div class="prose-church mt-8" set:html={bodyHtml} />
    </div>
  </section>
</SiteShell>
