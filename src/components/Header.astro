---
import { mainNav } from '../lib/navigation';

interface Props {
  churchName: string;
  logo?: string | null;
  givewayUrl?: string | null;
  currentPath?: string;
}

const { churchName, logo, givewayUrl, currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-eucalyptus-900/10 bg-mist-50/90 backdrop-blur-md">
  <div class="section-shell flex items-center justify-between gap-4 py-3 md:py-4">
    <a href="/" class="flex items-center gap-3 shrink-0">
      {
        logo && (
          <img
            src={logo}
            alt=""
            class="h-12 w-auto md:h-14"
            width="56"
            height="56"
          />
        )
      }
      <span class="font-display text-lg font-semibold leading-tight text-eucalyptus-900 md:text-xl">
        {churchName}
      </span>
    </a>

    <button
      type="button"
      class="nav-toggle inline-flex h-11 w-11 items-center justify-center rounded-md border border-eucalyptus-900/15 bg-white md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="main-nav"
      data-nav-toggle
    >
      <span class="sr-only">Menu</span>
      <span class="flex flex-col gap-1.5" aria-hidden="true">
        <span class="nav-toggle__bar block h-0.5 w-5 bg-eucalyptus-900 transition"></span>
        <span class="nav-toggle__bar block h-0.5 w-5 bg-eucalyptus-900 transition"></span>
        <span class="nav-toggle__bar block h-0.5 w-5 bg-eucalyptus-900 transition"></span>
      </span>
    </button>

    <nav
      id="main-nav"
      class="main-nav absolute left-0 right-0 top-full hidden max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-b border-eucalyptus-900/10 bg-mist-50 px-5 py-4 shadow-lg md:static md:block md:max-h-none md:overflow-visible md:border-0 md:bg-transparent md:p-0 md:shadow-none"
      data-main-nav
      aria-label="Main"
    >
      <ul class="flex flex-col items-start gap-1 md:flex-row md:flex-wrap md:items-center md:justify-end md:gap-x-5 md:gap-y-2">
        {
          mainNav.map((item) => {
            const active =
              item.href === '/'
                ? currentPath === '/'
                : currentPath === item.href || currentPath.startsWith(`${item.href}/`);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block rounded-md px-2 py-2 text-sm font-medium tracking-wide transition md:px-0 md:py-1',
                    active
                      ? 'text-eucalyptus-800'
                      : 'text-ink-700 hover:text-eucalyptus-700',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
        {
          givewayUrl && (
            <li class="pt-2 md:pt-0 md:pl-2">
              <a href={givewayUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">
                Giving
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function setupNav() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-main-nav]');
    if (!toggle || !nav) return;

    const setOpen = (open: boolean) => {
      nav.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('overflow-hidden', open && window.innerWidth < 768);
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) setOpen(false);
    });
  }

  setupNav();
  document.addEventListener('astro:page-load', setupNav);
</script>
