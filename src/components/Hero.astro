---
import { Image } from 'astro:assets';
import YouTubeIcon from '../assets/YouTube_full.svg';

interface Props {
  headline: string;
  subline?: string;
  image?: string | null;
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  youtubeUrl?: string | null;
  youtubeCtaLabel?: string;
}

const {
  headline,
  subline,
  image,
  primaryCtaLabel,
  primaryCtaHref,
  youtubeUrl,
  youtubeCtaLabel,
} = Astro.props;
---

<section class="relative isolate h-[50vh] max-h-[50vh] overflow-hidden bg-eucalyptus-950 text-white">
  {
    image && (
      <Image
        src={image}
        alt=""
        width={1688}
        height={577}
        class="absolute inset-0 h-full w-full object-cover animate-[fade-in_1.2s_ease-out_both]"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="absolute inset-0 bg-gradient-to-t from-eucalyptus-950 via-eucalyptus-950/70 to-eucalyptus-900/40"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,_rgba(201,134,45,0.18),_transparent_40%)]"></div>

  <div class="section-shell relative flex h-full flex-col justify-end pb-8 pt-20 md:pb-12">
    <div class="max-w-prose animate-[fade-up_0.9s_ease-out_both]">
      <h1 class="font-display text-4xl font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl">
        {headline}
      </h1>
      {
        subline && (
          <p class="mt-3 text-lg text-mist-100 md:text-xl">{subline}</p>
        )
      }
      <div class="mt-5 flex flex-wrap gap-3">
        {
          primaryCtaLabel && primaryCtaHref && (
            <a href={primaryCtaHref} class="btn-primary">
              {primaryCtaLabel}
            </a>
          )
        }
        {
          youtubeUrl && (
            <a
              href={youtubeUrl}
              class="btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <YouTubeIcon
                width="24"
                height="17"
                class="h-4 w-auto shrink-0"
                aria-hidden="true"
              />
              {youtubeCtaLabel || 'Find us on YouTube'}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
