---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getReader } from '../lib/reader';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const reader = getReader();
const settings = await reader.singletons.siteSettings.read();
if (!settings) {
  throw new Error('Site settings content is missing.');
}

const logo = settings.logo ? `/images/${settings.logo}` : null;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<BaseLayout title={title} description={description}>
  <Header
    churchName={settings.churchName}
    logo={logo}
    givewayUrl={settings.givewayUrl}
    currentPath={currentPath}
  />
  <main class="flex-1">
    <slot />
  </main>
  <Footer
    churchName={settings.churchName}
    serviceTime={settings.serviceTime}
    addressLine1={settings.addressLine1}
    addressLine2={settings.addressLine2}
    addressLine3={settings.addressLine3}
    phone={settings.phone}
    mapsUrl={settings.mapsUrl}
    copyrightStartYear={settings.copyrightStartYear ?? 2015}
    copyrightEndYear={settings.copyrightEndYear ?? 2026}
  />
</BaseLayout>
