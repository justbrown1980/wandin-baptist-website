---
import type { Ministry } from '../lib/ministries';

interface Props {
  ministries: Ministry[];
  /** When true, omit the section heading (e.g. page already has a banner). */
  hideHeading?: boolean;
}

const { ministries, hideHeading = false } = Astro.props;
---

<section id="ministries" class="bg-eucalyptus-900 py-16 text-mist-50 md:py-20">
  <div class="section-shell">
    {
      !hideHeading && (
        <>
          <h2 class="font-display text-3xl font-semibold tracking-tight text-white md:text-4xl">
            Ministries
          </h2>
          <p class="mt-3 max-w-prose text-mist-200">
            Ways to connect, grow, and serve together through the week.
          </p>
        </>
      )
    }

    <ul class:list={['grid gap-8 md:grid-cols-2', !hideHeading && 'mt-10']}>
      {
        ministries.map((ministry) => (
          <li class="border-t border-white/15 pt-6">
            <h3 class="font-display text-xl font-semibold text-white md:text-2xl">
              {ministry.title}
            </h3>
            {ministry.schedule && (
              <p class="mt-2 text-sm font-medium tracking-wide text-amber-500">
                {ministry.schedule}
              </p>
            )}
            <div
              class="prose-church mt-3 text-mist-100 [&_a]:text-amber-500 [&_p]:text-mist-100"
              set:html={ministry.descriptionHtml}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
